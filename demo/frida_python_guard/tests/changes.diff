+
+root = Path(__file__).resolve().parents[1]
+if root.name != "frida_python_guard" or root.parent.name != "demo":
+    raise SystemExit(f"unexpected rollback target: {root}")
+shutil.rmtree(root)
+print(f"removed {root}")
