+        for version, source in [('baseline', baseline), ('modified', ROOT)]:
+            repo, receiver = work / f'{version}-repo', work / f'{version}.git'
+            repo.mkdir(); receiver.mkdir()
+            g(repo, 'init', '-b', 'main'); g(receiver, 'init', '--bare')
