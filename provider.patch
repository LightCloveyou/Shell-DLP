+                            if (state.PolicyReports.Count >= MaxEffects) state.PolicyReports.RemoveAt(0);
+                            state.PolicyReports.Add(Data("kind", File ? "copy" : "persistent-variable", "target", File ? Target : Name,
+                                "scope", Scope, "status", outcome));
+                        }
