diff --git a/ast/Parser.cs b/ast/Parser.cs
new file mode 100644
index 0000000..baeee85
--- /dev/null
+++ b/ast/Parser.cs
@@ -0,0 +1,214 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net;
+using System.Reflection;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace PowerShell7Guard
+{
+    public static partial class AstBridge
+    {
+        [StructLayout(LayoutKind.Sequential)]
+        struct Request { public IntPtr Source, Output; public int Length, Capacity, Decision; }
+        const int MaxReportNodes = 512, MaxPolicyNodes = 4096;
+        static readonly string[] Kinds = {
+            "CommandAst", "PipelineAst", "VariableExpressionAst", "StringConstantExpressionAst",
+            "ExpandableStringExpressionAst", "InvokeMemberExpressionAst", "AssignmentStatementAst"
+        };
+        static readonly HashSet<string> ParameterValues = new HashSet<string>(
+            new[] { "Uri", "Body", "Method", "Path", "LiteralPath", "InFile", "OutFile", "FilePath", "Destination" },
+            StringComparer.OrdinalIgnoreCase);
+        static readonly HashSet<string> PathParameters = new HashSet<string>(
+            new[] { "Path", "LiteralPath", "InFile", "OutFile", "FilePath", "Destination" },
+            StringComparer.OrdinalIgnoreCase);
+        static readonly HashSet<string> FileCommands = new HashSet<string>(
+            new[] { "Get-Content", "Set-Content", "Add-Content", "Copy-Item", "Move-Item", "Remove-Item", "gc", "cat", "type" },
+            StringComparer.OrdinalIgnoreCase);
+
+        static object? Prop(object? o, string name)
+        {
+            for (var type = o?.GetType(); type != null; type = type.BaseType)
+            {
+                var property = type.GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.DeclaredOnly);
+                if (property != null) return property.GetValue(o);
+            }
+            return null;
+        }
+        static string Str(object? o) => o?.ToString() ?? "";
+        static string Kind(object? o) => o?.GetType().Name ?? "";
+        static IEnumerable<object> Items(object? o) => (o as IEnumerable)?.Cast<object>() ?? Enumerable.Empty<object>();
+        static string Command(object o) => Str(o.GetType().GetMethod("GetCommandName")?.Invoke(o, null));
+        static bool Interesting(object o) => Array.IndexOf(Kinds, Kind(o)) >= 0;
+        static string? Literal(object? o) => Kind(o) == "StringConstantExpressionAst" ? Str(Prop(o, "Value")) : null;
+        static string Small(string s) => s.Length <= 2048 ? s : s.Substring(0, 2048) + "…";
+        static Dictionary<string, object?> Data(params object?[] entries) {
+            var result = new Dictionary<string, object?>();
+            for (int i = 0; i < entries.Length; i += 2) result.Add((string)entries[i]!, entries[i + 1]);
+            return result;
+        }
+
+        static bool HasUsingDirective(Type parser, string source)
+        {
+            if (source.IndexOf("using", StringComparison.OrdinalIgnoreCase) < 0) return false;
+            // Tokenize without calling ParseInput: using module/assembly can resolve external
+            // files even while the parser is reporting other syntax errors.
+            try
+            {
+                var type = parser.Assembly.GetType("System.Management.Automation.Language.Tokenizer", true)!;
+                var scanner = type.GetConstructor(Instance, null, new[] { parser }, null)!
+                    .Invoke(new[] { Activator.CreateInstance(parser, true) });
+                type.GetMethod("Initialize", Instance)!.Invoke(scanner, new object?[] { null, source, null });
+                var next = type.GetMethod("NextToken", Instance)!;
+                for (int i = 0; i <= source.Length; i++)
+                {
+                    var token = next.Invoke(scanner, null);
+                    var kind = Str(Prop(token, "Kind"));
+                    if (kind == "EndOfInput") return false;
+                    if (kind == "Using") return true;
+                    // The tokenizer defers parsing expandable-string subexpressions.
+                    if (Items(Prop(token, "NestedTokens")).Any(t => Str(Prop(t, "Text"))
+                        .IndexOf("using", StringComparison.OrdinalIgnoreCase) >= 0)) return true;
+                }
+            }
+            catch { }
+            return true; // unknown tokenizer version: keep the conservative behavior
+        }
+
+        public static int Analyze(IntPtr data, int size)
+        {
+            try
+            {
+                if (size != Marshal.SizeOf<Request>()) return -1;
+                var req = Marshal.PtrToStructure<Request>(data);
+                if (req.Length < 1 || req.Length > 32768) return -1;
+                var source = Marshal.PtrToStringUni(req.Source, req.Length)!;
+                var parser = Type.GetType("System.Management.Automation.Language.Parser, System.Management.Automation", false) ??
+                    AppDomain.CurrentDomain.GetAssemblies().Select(a => a.GetType("System.Management.Automation.Language.Parser")).FirstOrDefault(t => t != null);
+                if (parser == null) return -1;
+                if (HasUsingDirective(parser, source))
+                {
+                    req.Decision = 3;
+                    Marshal.StructureToPtr(req, data, false);
+                    return -2;
+                }
+                var parse = parser.GetMethods().Single(m => m.Name == "ParseInput" && m.GetParameters().Length == 3);
+                var args = new object?[] { source, null, null };
+                var ast = parse.Invoke(null, args);
+                if (ast == null) return -1;
+                var walk = ast.GetType().GetMethod("FindAll")!;
+                var filter = Delegate.CreateDelegate(walk.GetParameters()[0].ParameterType,
+                    typeof(AstBridge).GetMethod(nameof(Interesting), BindingFlags.Static | BindingFlags.NonPublic)!);
+                var nodes = Items(walk.Invoke(ast, new object[] { filter, true })).Take(MaxPolicyNodes + 1).ToArray();
+                var errors = Items(args[2]).Take(64).Select(e => Data("id", Prop(e, "ErrorId"),
+                    "line", Prop(Prop(e, "Extent"), "StartLineNumber"))).ToArray();
+                var paths = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var urls = new HashSet<string>(StringComparer.Ordinal);
+                var ips = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var domains = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var commands = new List<object>();
+                var pipelines = new List<object>();
+                var variables = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var strings = new HashSet<string>(StringComparer.Ordinal);
+                var expandable = new HashSet<string>(StringComparer.Ordinal);
+                var dynamic = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var external = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var encoding = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                var root = Items(Prop(Prop(ast, "EndBlock"), "Statements")).Take(513).ToArray();
+                var flow = Flow.Create(parser.Assembly, nodes.Take(MaxReportNodes), root);
+                req.Decision = errors.Length > 0 ? 4 : 0;
+                foreach (var node in nodes.Take(MaxReportNodes))
+                {
+                    switch (Kind(node))
+                    {
+                        case "CommandAst":
+                            var name = Command(node);
+                            flow.IsShadowed(name);
+                            var op = Str(Prop(node, "InvocationOperator"));
+                            var elements = Items(Prop(node, "CommandElements")).ToArray();
+                            var parameters = new List<object>();
+                            for (int i = 1; i < elements.Length; i++)
+                            {
+                                var el = elements[i];
+                                if (Kind(el) != "CommandParameterAst") continue;
+                                var key = Str(Prop(el, "ParameterName"));
+                                var arg = Prop(el, "Argument");
+                                if (arg == null && ParameterValues.Contains(key) && i + 1 < elements.Length) arg = elements[i + 1];
+                                var val = Literal(arg);
+                                var resolved = val == null && arg != null ? flow.Resolve(arg) : null;
+                                parameters.Add(Data("name", key, "literal", val == null ? null : Small(val),
+                                    "valueSource", resolved?.Source, "valueKnown", resolved?.Known));
+                                if (val != null && PathParameters.Contains(key)) paths.Add(Small(val));
+                            }
+                            if (FileCommands.Contains(name) && elements.Length > 1 && Literal(elements[1]) is string path) paths.Add(Small(path));
+                            commands.Add(Data("name", name, "invocationOperator", op,
+                                "line", Prop(Prop(node, "Extent"), "StartLineNumber"), "parameters", parameters));
+                            if (op == "Ampersand" || op == "Dot" || Regex.IsMatch(name, @"^(?:Invoke-Expression|iex)$", RegexOptions.IgnoreCase)) dynamic.Add(name.Length > 0 ? name : op);
+                            if (Regex.IsMatch(name, @"(?:\.(?:exe|cmd|bat|com)$|^(?:curl|ncat|scp|ssh|git|wget)$)", RegexOptions.IgnoreCase)) external.Add(name);
+                            break;
+                        case "PipelineAst":
+                            var pipe = Items(Prop(node, "PipelineElements")).ToArray();
+                            if (pipe.Length > 1) pipelines.Add(pipe.Select(e => Kind(e) == "CommandAst" ? Command(e) : Kind(e)).ToArray());
+                            break;
+                        case "VariableExpressionAst": variables.Add(Str(Prop(Prop(node, "VariablePath"), "UserPath"))); break;
+                        case "ExpandableStringExpressionAst": expandable.Add(Small(Str(Prop(Prop(node, "Extent"), "Text")))); break;
+                        case "StringConstantExpressionAst":
+                            var literal = Str(Prop(node, "Value"));
+                            if (Str(Prop(node, "StringConstantType")) != "BareWord") strings.Add(Small(literal));
+                            if (Regex.IsMatch(literal, @"^(?:[A-Za-z]:[\\/]|\\\\|\.\.?[\\/]|/(?!/))")) paths.Add(Small(literal));
+                            var host = literal;
+                            if (Regex.IsMatch(literal, @"^[a-z][a-z0-9+.-]*://", RegexOptions.IgnoreCase) &&
+                                Uri.TryCreate(literal, UriKind.Absolute, out var target) && target.Host.Length > 0)
+                            { urls.Add(Small(literal)); host = target.DnsSafeHost; }
+                            if ((host.Contains(".") || host.Contains(":")) && IPAddress.TryParse(host, out var ip)) ips.Add(ip.ToString());
+                            else if (host.Length <= 253 && Regex.IsMatch(host, @"^(?:[a-z0-9][a-z0-9-]*\.)+[a-z][a-z0-9-]*$", RegexOptions.IgnoreCase) &&
+                                !Regex.IsMatch(host, @"\.(?:exe|cmd|dll|ps1|txt|json|csv|zip|log)$", RegexOptions.IgnoreCase)) domains.Add(host);
+                            break;
+                        case "InvokeMemberExpressionAst":
+                            var member = Literal(Prop(node, "Member"));
+                            if (member != null && Regex.IsMatch(member, @"^(?:FromBase64String|ToBase64String|FromBase64CharArray|ToBase64CharArray|GetBytes|GetString|UrlEncode|UrlDecode)$", RegexOptions.IgnoreCase)) encoding.Add(member);
+                            break;
+                    }
+                }
+                var plan = req.Decision == 4 ? new RulePlan() :
+                    new AdapterContext(flow).Build(root, nodes.Take(MaxPolicyNodes), nodes.Length > MaxPolicyNodes);
+                if (req.Decision != 4) req.Decision = plan.Decision;
+                if (req.Decision != 1 && req.Decision != 4) flow.Schedule(plan);
+                Marshal.StructureToPtr(req, data, false);
+                var report = Data("status", errors.Length == 0 ? "parsed" : "syntax-error", "truncated", nodes.Length > MaxReportNodes,
+                    "commands", commands, "filePaths", paths, "urls", urls, "ipAddresses", ips, "domains", domains,
+                    "pipelines", pipelines, "variables", variables, "stringLiterals", strings, "expandableStrings", expandable,
+                    "dynamicExecution", dynamic, "externalCommands", external, "encodingCalls", encoding, "parseErrors", errors,
+                    "dataFlow", flow.Report(), "policy", Data("decision", plan.Reason, "configuration", plan.Configuration,
+                        "evidence", plan.Evidence, "pending", plan.Work.Select(w => Data("kind", w.File ? "copy" : "persistent-variable",
+                            "target", w.File ? w.Target : w.Name, "scope", w.Scope)).ToArray()));
+                var serializer = Type.GetType("System.Text.Json.JsonSerializer, System.Text.Json", true)!;
+                var serialize = serializer.GetMethods().First(m => m.Name == "Serialize" && m.IsGenericMethodDefinition &&
+                    m.ReturnType == typeof(string) && m.GetParameters().Length == 2 && m.GetParameters()[1].ParameterType.Name == "JsonSerializerOptions");
+                var writeJson = serialize.MakeGenericMethod(report.GetType());
+                byte[] Encode(Dictionary<string, object?> record) =>
+                    Encoding.UTF8.GetBytes((string)writeJson.Invoke(null, new object?[] { record, null })!);
+                var bytes = Encode(report);
+                if (bytes.Length > req.Capacity)
+                {
+                    // AST detail may overflow independently of the policy decision. Keep the
+                    // decisive evidence instead of replacing the entire event with a status.
+                    bytes = Encode(Data("status", errors.Length == 0 ? "parsed" : "syntax-error", "truncated", true,
+                        "truncation", "report-output-limit", "policy", Data("decision", plan.Reason,
+                            "configuration", plan.Configuration, "evidence",
+                            plan.PrimaryEvidence == null ? Array.Empty<object>() : new[] { plan.PrimaryEvidence })));
+                }
+                if (bytes.Length > req.Capacity)
+                    bytes = Encode(Data("status", errors.Length == 0 ? "parsed" : "syntax-error", "truncated", true,
+                        "truncation", "report-output-limit", "policy", Data("decision", plan.Reason)));
+                if (bytes.Length > req.Capacity) return -3;
+                Marshal.Copy(bytes, 0, req.Output, bytes.Length);
+                return bytes.Length;
+            }
+            catch { return -1; }
+        }
+    }
+}
diff --git a/ast/RunspaceState.cs b/ast/RunspaceState.cs
new file mode 100644
index 0000000..f0b26b1
--- /dev/null
+++ b/ast/RunspaceState.cs
@@ -0,0 +1,510 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Text.RegularExpressions;
+
+namespace PowerShell7Guard
+{
+    public static partial class AstBridge
+    {
+        const BindingFlags Instance = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+        const int MaxVars = 64;
+        static readonly ConditionalWeakTable<object, State> Sessions = new ConditionalWeakTable<object, State>();
+        static readonly ConditionalWeakTable<object, Pending> Pipelines = new ConditionalWeakTable<object, Pending>();
+
+        static object? InternalProp(object? o, string name)
+        {
+            for (var type = o?.GetType(); type != null; type = type.BaseType)
+            {
+                var prop = type.GetProperty(name, Instance | BindingFlags.DeclaredOnly);
+                if (prop != null) return prop.GetValue(o);
+            }
+            return null;
+        }
+
+        static object? Method(object? o, string name, Type[] signature, params object[] args) =>
+            o?.GetType().GetMethod(name, Instance, null, signature, null)?.Invoke(o, args);
+
+        static string VarName(object? node) => Kind(node) == "VariableExpressionAst"
+            ? Str(Prop(Prop(node, "VariablePath"), "UserPath")) : "";
+        static bool SafeName(string name) => name.Length <= 128 &&
+            Regex.IsMatch(name, @"^(?:(?:global|local|env):)?[a-z0-9_][a-z0-9_.-]*$", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
+        static bool EnvName(string s) => s.StartsWith("env:", StringComparison.OrdinalIgnoreCase);
+        static bool GlobalName(string s) => s.StartsWith("global:", StringComparison.OrdinalIgnoreCase);
+        static string BaseName(string s) => s.Substring(s.IndexOf(':') + 1);
+        static string Canonical(string s) => EnvName(s) ? "env:" + BaseName(s) : "global:" + BaseName(s);
+        static bool SafeStableVariable(string name)
+        {
+            return !EnvName(name) && !Regex.IsMatch(BaseName(name),
+                @"^(?:\d+|null|true|false|args|input|error|host|pwd|home|pid|pscmdlet|psitem|myinvocation|executioncontext|lastexitcode|matches|_)$",
+                RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
+        }
+
+        sealed class Observed
+        {
+            public readonly bool Known;
+            public readonly string? Text;
+            public readonly string Source;
+            public readonly string Type;
+            public readonly string? Origin;
+            public readonly string[]? Dependencies;
+            public readonly Mark[] Marks;
+            public Observed(bool known, string? text, string source, string type, string? origin = null,
+                string[]? dependencies = null, Mark[]? marks = null)
+            { Known = known; Text = text; Source = source; Type = type; Origin = origin; Dependencies = dependencies; Marks = marks ?? Array.Empty<Mark>(); }
+            public bool? Sensitive => Known ? Marks.Length != 0 || (Text != null && Store.Current(out _)?.Rules.Any(
+                r => r.Texts.Any(t => Text.IndexOf(t, StringComparison.Ordinal) >= 0)) == true) : (bool?)null;
+            public Observed At(string source) => new Observed(Known, Text, source, Type, Origin, Dependencies, Marks);
+            public Observed From(Assignment assignment, Mark[]? marks = null) =>
+                new Observed(Known, Text, Source, Type, assignment.Origin, assignment.DependsOn, marks);
+            public object Report(string name) => Data("name", name, "known", Known, "valueType", Type,
+                "valueLength", Text?.Length, "sensitive", Sensitive, "valueSource", Source,
+                "candidateOrigin", Origin, "dependsOn", Dependencies, "flow", Marks.Select(m => m.Report()).ToArray());
+            public bool Same(Observed other) => Known && other.Known &&
+                Type == other.Type && string.Equals(Text, other.Text, StringComparison.Ordinal);
+        }
+
+        static Observed Unknown(string source) => new Observed(false, null, source, "");
+        static Observed Scalar(object? value, string source)
+        {
+            // Cmdlet output can carry a built-in PSObject wrapper. Unwrap only
+            // that exact runtime type, then apply the existing scalar allowlist.
+            for (int i = 0; i < 3 && value != null &&
+                value.GetType().FullName == "System.Management.Automation.PSObject" &&
+                value.GetType().Assembly.GetName().Name == "System.Management.Automation"; i++)
+            {
+                var inner = Prop(value, "ImmediateBaseObject");
+                if (ReferenceEquals(inner, value)) break;
+                value = inner;
+            }
+            if (value == null) return new Observed(true, null, source, "null");
+            string? text;
+            switch (value)
+            {
+                case string s: text = s; break;
+                case bool b: text = b ? "True" : "False"; break;
+                case byte _: case sbyte _: case short _: case ushort _: case int _: case uint _:
+                case long _: case ulong _: case float _: case double _: case decimal _: case char _:
+                    text = Convert.ToString(value, CultureInfo.InvariantCulture); break;
+                default: return Unknown("unsupported-runtime-type");
+            }
+            return text?.Length > 4096 ? Unknown("runtime-value-limit") :
+                new Observed(true, text, source, value.GetType().Name);
+        }
+
+        static Observed Read(object? engineState, string name, bool forceGlobal = false)
+        {
+            try
+            {
+                if (!SafeName(name)) return Unknown("unsupported-variable-name");
+                if (EnvName(name))
+                {
+                    var v = Environment.GetEnvironmentVariable(BaseName(name));
+                    return v == null ? Unknown("environment-not-found") : Scalar(v, "process-environment");
+                }
+                if (engineState == null) return Unknown("runspace-unavailable");
+                var variable = forceGlobal || GlobalName(name)
+                    ? Method(engineState, "GetVariableAtScope", new[] { typeof(string), typeof(string) }, BaseName(name), "global")
+                    : Method(engineState, "GetVariable", new[] { typeof(string) }, name);
+                // Never evaluate custom variable getters or stringify arbitrary script objects.
+                if (variable == null) return Unknown("variable-not-found");
+                if (Kind(variable) != "PSVariable") return Unknown("custom-variable");
+                return Scalar(Prop(variable, "Value"), "runtime");
+            }
+            catch { return Unknown("runtime-unavailable"); }
+        }
+
+        sealed class State
+        {
+            internal readonly object Gate = new object();
+            internal sealed class Entry
+            {
+                internal readonly Observed Snapshot;
+                internal readonly long Revision;
+                internal Entry(Observed snapshot, long revision) { Snapshot = snapshot; Revision = revision; }
+            }
+            internal readonly Dictionary<string, Entry> Values = new Dictionary<string, Entry>(StringComparer.OrdinalIgnoreCase);
+            internal readonly List<object> Reports = new List<object>();
+            internal readonly List<object> PolicyReports = new List<object>();
+            internal long Revision;
+            internal void Invalidate() => Revision++;
+            internal void MarkDirty(string key)
+            {
+                if (Values.TryGetValue(key, out var entry))
+                    Values[key] = new Entry(entry.Snapshot, Revision - 1);
+            }
+            internal void Put(string key, Observed value, long revision)
+            {
+                if (!value.Known) { Values.Remove(key); return; }
+                if (!Values.ContainsKey(key) && Values.Count >= MaxVars) Values.Remove(Values.Keys.First());
+                Values[key] = new Entry(value, revision);
+            }
+        }
+
+        sealed class Assignment
+        {
+            internal readonly string Name, Origin;
+            internal readonly string[] DependsOn;
+            internal readonly bool Persistent;
+            internal readonly Observed Before, Prediction;
+            internal Assignment(string name, string origin, string[] deps, bool persistent, Observed before, Observed prediction)
+            { Name = name; Origin = origin; DependsOn = deps; Persistent = persistent; Before = before; Prediction = prediction; }
+        }
+
+        sealed class Pending
+        {
+            readonly State state;
+            readonly object engine;
+            readonly List<Assignment> writes = new List<Assignment>();
+            readonly Dictionary<string, Payload> labels = new Dictionary<string, Payload>(StringComparer.OrdinalIgnoreCase);
+            readonly List<PolicyWork> work = new List<PolicyWork>();
+            readonly EventInfo changed;
+            readonly Delegate handler;
+            internal bool UnknownEffects;
+            internal Pending(State state, object engine, object pipeline)
+            {
+                this.state = state; this.engine = engine;
+                changed = pipeline.GetType().GetEvent("StateChanged", Instance) ?? throw new InvalidOperationException();
+                handler = Delegate.CreateDelegate(changed.EventHandlerType!, this,
+                    typeof(Pending).GetMethod(nameof(Completed), Instance)!);
+                changed.AddEventHandler(pipeline, handler);
+            }
+
+            internal void Add(IEnumerable<Assignment> assignments, bool unknown, RulePlan plan)
+            {
+                lock (state.Gate)
+                {
+                    UnknownEffects |= unknown;
+                    if (unknown) state.Invalidate();
+                    foreach (var write in assignments.Where(a => a.Persistent).Take(MaxVars))
+                    {
+                        if (writes.Count >= MaxVars) { UnknownEffects = true; state.Invalidate(); break; }
+                        var key = Canonical(write.Name);
+                        var old = writes.FindIndex(x => string.Equals(Canonical(x.Name), key, StringComparison.OrdinalIgnoreCase));
+                        if (old >= 0)
+                        {
+                            writes[old] = new Assignment(write.Name, "multiple-writes", write.DependsOn, true,
+                                writes[old].Before, write.Prediction);
+                            labels.Remove(key);
+                        }
+                        else
+                        {
+                            writes.Add(write);
+                            if (plan.Assignments.TryGetValue(key, out var label)) labels[key] = label;
+                            else if (plan.Assignments.TryGetValue(write.Name, out label)) labels[key] = label;
+                        }
+                        state.MarkDirty(key); // Preserve provenance, but confirm the value before reuse.
+                    }
+                    foreach (var update in plan.Work.Take(Math.Max(0, MaxEffects - work.Count)))
+                    { update.Register(); work.Add(update); }
+                }
+            }
+
+            void Completed(object? sender, EventArgs e)
+            {
+                try
+                {
+                    var outcome = Str(Prop(Prop(e, "PipelineStateInfo"), "State"));
+                    if (outcome != "Completed" && outcome != "Failed" && outcome != "Stopped") return;
+                    if (sender != null)
+                    {
+                        changed.RemoveEventHandler(sender, handler);
+                        Pipelines.Remove(sender);
+                    }
+                    Assignment[] candidates;
+                    lock (state.Gate) candidates = writes.ToArray();
+                    var observed = candidates.Select(a => (a, value: Read(engine, a.Name, true))).ToArray();
+                    lock (state.Gate)
+                    {
+                        if (UnknownEffects || outcome != "Completed") state.Invalidate();
+                        foreach (var pair in observed)
+                        {
+                            var a = pair.a;
+                            var mark = outcome == "Completed" && labels.TryGetValue(Canonical(a.Name), out var label) &&
+                                label.Text != null && pair.value.Known && label.Text == pair.value.Text ? label.Tags : null;
+                            var value = pair.value.From(a, mark);
+                            if (outcome == "Completed" && SafeStableVariable(a.Name))
+                                state.Put(Canonical(a.Name), value.At("observed-after-pipeline"), state.Revision);
