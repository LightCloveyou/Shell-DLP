+            }
+        }
+
+        static class DurableEnv
+        {
+            [DllImport("advapi32.dll", CharSet = CharSet.Unicode)]
+            static extern int RegOpenKeyExW(IntPtr key, string subkey, uint options, uint access, out IntPtr handle);
