+                var proof = GitProof.TryRead(cwd, arguments.Skip(1).ToArray(), policy);
+                if (proof == null) Send("git push", arguments.ElementAtOrDefault(1), Array.Empty<Payload>(), "git-baseline-or-preflight");
+                else if (!barrier && proof.Loopback) SkipLoopback("git push", proof.Endpoint);
+                else if (proof.Network) Send("git push", proof.Endpoint, proof.Parts);
+            }
+
+            Payload? Pipeline(object? node, int depth = 0)
+            {
+                if (node == null) return null;
+                if (depth > MaxExpressionDepth) return Missing("expression-limit");
+                if (Kind(node) == "CommandExpressionAst") return Expression(Prop(node, "Expression"), depth);
+                if (Kind(node) != "PipelineAst") return Missing("control-flow");
+                Payload? result = null;
+                var elements = Items(Prop(node, "PipelineElements")).Take(MaxEffects + 1).ToArray();
+                foreach (var element in elements.Take(MaxEffects))
+                {
+                    if (Kind(element) == "CommandExpressionAst") result = Expression(Prop(element, "Expression"), depth);
+                    else if (Kind(element) == "CommandAst")
+                    {
+                        var name = Tool(Name(element));
+                        if (Network(name)) visitedNetwork.Add(element);
+                        if (Str(Prop(element, "InvocationOperator")) != "Unknown" ||
+                            (name == "compress-archive" ? !flow.IsStockArchive(name) : flow.IsShadowed(Name(element))))
+                        {
+                            if (Network(name)) Send(name, null, Array.Empty<Payload>(), "command-definition");
+                            else if (name == "compress-archive") ReportMissing("archive-command-definition");
+                            barrier = true;
+                            result = Missing("command-definition");
+                        }
+                        else if (name == "invoke-webrequest" || name == "invoke-restmethod") { HttpCmd(element, name, result); result = null; barrier = true; }
+                        else if (name == "curl") { Curl(element, result); result = null; barrier = true; }
+                        else if (name == "scp") { Scp(element); result = null; barrier = true; }
+                        else if (name == "git") { Git(element); result = null; barrier = true; }
+                        else
+                        {
+                            result = LocalCommand(element, name, result);
+                            if (result?.Issue == "unsupported-propagation") barrier = true;
+                        }
+                    }
+                    else { barrier = true; result = Missing("pipeline-element"); }
+
+                    foreach (var redir in Items(Prop(element, "Redirections")).Take(MaxEffects))
+                    {
+                        if (Kind(redir) == "FileRedirectionAst" && Str(Prop(redir, "FromStream")) == "Output")
+                        {
+                            var path = Value(Prop(redir, "Location")).Text;
+                            PlanWrite(path, result ?? Missing("redirect-input"), null, Equals(Prop(redir, "Append"), true));
+                            result = null;
+                        }
+                        else { barrier = true; result = Missing("unsupported-redirection"); }
+                    }
+                }
+                if (elements.Length > MaxEffects)
+                {
+                    ReportMissing("pipeline-limit");
+                    barrier = true;
+                    return Missing("pipeline-limit");
+                }
+                return result;
+            }
+
+            static bool EnvironmentMethod(object? expression, string method)
+            {
+                if (Kind(expression) != "InvokeMemberExpressionAst" || !Equals(Prop(expression, "Static"), true) ||
+                    !string.Equals(Literal(Prop(expression, "Member")), method, StringComparison.OrdinalIgnoreCase)) return false;
+                var target = Prop(expression, "Expression");
+                var type = Str(Prop(Prop(target, "TypeName"), "FullName"));
+                return Kind(target) == "TypeExpressionAst" && (type.Equals("Environment", StringComparison.OrdinalIgnoreCase) ||
+                    type.Equals("System.Environment", StringComparison.OrdinalIgnoreCase));
+            }
+            Payload Expression(object? expression, int depth)
+            {
+                if (EnvironmentMethod(expression, "SetEnvironmentVariable"))
+                {
+                    var args = Items(Prop(expression, "Arguments")).ToArray();
+                    if (args.Length == 3 && plan.Work.Count < MaxEffects && !barrier)
+                    {
+                        var name = Value(args[0]).Text;
+                        var value = Value(args[1]);
+                        var scope = Value(args[2]).Text?.ToLowerInvariant();
+                        bool isNull = VarName(args[1]).Equals("null", StringComparison.OrdinalIgnoreCase);
+                        if (name != null && SafeName(name) && !name.Contains(":") &&
+                            (scope == "user" || scope == "machine") && (isNull || value.Text != null) &&
+                            (value.Complete || value.Tags.Length != 0 || isNull) &&
+                            DurableEnv.Read(scope!, name, out _, out var stamp))
+                            plan.Work.Add(new PolicyWork { Scope = scope!, Name = name, Before = stamp,
+                                Value = isNull ? null : value.Text, Tags = isNull ? Array.Empty<Mark>() : value.Via(scope + ":" + name).Tags });
+                    }
+                    return Missing("no-expression-output");
+                }
+                if (EnvironmentMethod(expression, "GetEnvironmentVariable"))
+                {
+                    var args = Items(Prop(expression, "Arguments")).ToArray();
+                    if (args.Length == 2 && !barrier)
+                    {
+                        var name = Value(args[0]).Text;
+                        var scope = Value(args[1]).Text?.ToLowerInvariant();
+                        if (name != null && (scope == "user" || scope == "machine") && DurableEnv.Owner(scope!) is string owner &&
+                            DurableEnv.Read(scope!, name, out var actual, out var stamp))
+                        {
+                            var records = Store.Persistent(scope!, owner, name).ToArray();
+                            var value = Text(actual, scope + ":" + name, Merge(records.Where(s => s.Get("stamp") == stamp)
+                                .Select(s => new Mark(s.Get("rule_id"), s.Get("origin"), s.Get("route")))));
+                            if (records.Any(s => s.Get("stamp") != stamp)) { value.Complete = false; value.Issue = "persistent-variable-stale"; }
+                            return value;
+                        }
+                    }
+                    return Missing("persistent-variable-value");
+                }
+                if (Kind(expression) == "ParenExpressionAst")
+                    return Pipeline(Prop(expression, "Pipeline"), depth + 1) ?? Missing("parenthesized-value");
+                return Value(expression, depth);
+            }
+
+            void ReportMissing(string issue)
+            {
+                var reason = "missing:" + issue;
+                plan.Result(3, reason, Data("decision", reason));
+            }
+
+            internal RulePlan Build(object[] root, IEnumerable<object> nodes, bool truncated)
+            {
+                foreach (var node in root.Take(MaxStatements))
+                {
+                    if (Kind(node) == "AssignmentStatementAst" && Str(Prop(node, "Operator")) == "Equals" &&
+                        SafeName(VarName(Prop(node, "Left"))))
+                    {
+                        var name = VarName(Prop(node, "Left"));
+                        var value = Pipeline(Prop(node, "Right")) ?? Missing("assignment-value");
+                        var propagated = value.Via("$" + name);
+                        values[Key(name)] = propagated;
+                        plan.Assignments[Key(name)] = propagated;
+                    }
+                    else if (Kind(node) == "PipelineAst" || Kind(node) == "CommandExpressionAst") Pipeline(node);
+                    else barrier = true;
+                }
+                var nestedNetwork = nodes.Where(x => Kind(x) == "CommandAst" && !visitedNetwork.Contains(x)).Any(x =>
+                {
+                    var name = Tool(Name(x));
+                    return Network(name) && (name != "git" || string.Equals(Literal(Items(
+                        Prop(x, "CommandElements")).ElementAtOrDefault(1)), "push", StringComparison.OrdinalIgnoreCase));
+                });
+                if (root.Length > MaxStatements || truncated) ReportMissing("analysis-limit");
+                else if (nestedNetwork) ReportMissing("unsupported-control-flow");
+                if ((plan.Decision != 0 || plan.Work.Count != 0) && !flow.ValidateCachedInputs())
+                {
+                    plan.Work.Clear(); plan.Assignments.Clear();
+                    if (plan.Decision != 0)
+                    {
+                        plan.Decision = 3; plan.Reason = "missing:variable-changed";
+                        plan.PrimaryEvidence = Data("decision", plan.Reason);
+                        plan.Evidence.Clear();
+                        plan.Evidence.Add(plan.PrimaryEvidence);
+                    }
+                }
+                return plan;
+            }
+        }
+    }
+}
diff --git a/ast/ContentTransforms.cs b/ast/ContentTransforms.cs
new file mode 100644
index 0000000..3956370
--- /dev/null
+++ b/ast/ContentTransforms.cs
@@ -0,0 +1,306 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Text;
+
+namespace PowerShell7Guard
+{
+    public static partial class AstBridge
+    {
+        sealed partial class AdapterContext
+        {
+            const int MaxPackedEntries = 64, MaxExpanded = 256 * 1024, MaxPackedDepth = 2;
+
+            static string TypeName(object? type) => Str(Prop(Prop(type, "TypeName"), "FullName")).ToLowerInvariant();
+
+            Payload Bytes(byte[] data, string origin, Mark[]? marks = null)
+            {
+                var text = Disk.Decode(data);
+                var result = Text(text, origin, marks);
+                result.Bytes = data;
+                result.Text = null; // byte[] and string bind differently in PowerShell
+                result.IsString = false;
+                return result;
+            }
+
+            Payload? Transform(object? node, int depth)
+            {
+                if (Kind(node) != "InvokeMemberExpressionAst") return null;
+                var member = Literal(Prop(node, "Member"))?.ToLowerInvariant();
+                var target = Prop(node, "Expression");
+                var args = Items(Prop(node, "Arguments")).Take(2).ToArray();
+                if (Equals(Prop(node, "Static"), true) && Kind(target) == "TypeExpressionAst" &&
+                    TypeName(target) is "convert" or "system.convert" &&
+                    member is "tobase64string" or "frombase64string")
+                {
+                    if (args.Length != 1) return Missing("base64-arguments");
+                    var arg = Value(args[0], depth + 1);
+                    string step = member == "tobase64string" ? "Base64 encode" : "Base64 decode";
+                    var tags = arg.Tags.Select(m => m.Via(step)).ToArray();
+                    try
+                    {
+                        if (member == "tobase64string" && arg.Bytes != null && arg.Bytes.Length <= (MaxContent / 4) * 3)
+                            return Text(Convert.ToBase64String(arg.Bytes), step, tags);
+                        if (member == "frombase64string" && arg.IsString && arg.Text != null && arg.Text.Length <= MaxContent)
+                            return Bytes(Convert.FromBase64String(arg.Text), step, tags);
+                    }
+                    catch (FormatException) { return Missing("base64-invalid"); }
+                    return Missing("base64-input");
+                }
+                if (!Equals(Prop(node, "Static"), true) && Kind(target) == "MemberExpressionAst" &&
+                    Equals(Prop(target, "Static"), true) && Kind(Prop(target, "Expression")) == "TypeExpressionAst" &&
+                    TypeName(Prop(target, "Expression")) is "text.encoding" or "system.text.encoding" &&
+                    member is "getbytes" or "getstring")
+                {
+                    var name = Literal(Prop(target, "Member"))?.ToLowerInvariant();
+                    Encoding? encoding = name switch
+                    {
+                        "utf8" => StrictUtf8,
+                        "unicode" => new UnicodeEncoding(false, false, true),
+                        "bigendianunicode" => new UnicodeEncoding(true, false, true),
+                        _ => null
+                    };
+                    if (encoding == null || args.Length != 1) return Missing("encoding-arguments");
+                    var arg = Value(args[0], depth + 1);
+                    string step = name + (member == "getbytes" ? " bytes" : " text");
+                    var tags = arg.Tags.Select(m => m.Via(step)).ToArray();
+                    try
+                    {
+                        if (member == "getbytes" && arg.IsString && arg.Text != null &&
+                            encoding.GetByteCount(arg.Text) <= MaxContent)
+                            return Bytes(encoding.GetBytes(arg.Text), step, tags);
+                        if (member == "getstring" && arg.Bytes != null && arg.Bytes.Length <= MaxContent)
+                            return Text(encoding.GetString(arg.Bytes), step, tags);
+                    }
+                    catch (ArgumentException) { return Missing("encoding-invalid"); }
+                    return Missing("encoding-input");
+                }
+                return null;
+            }
+
+            static byte[]? CanonicalBase64(string? value)
+            {
+                if (value == null) return null;
+                value = value.Trim();
+                if (value.Length < 12 || value.Length > MaxContent || value.Length % 4 != 0) return null;
+                foreach (char c in value)
+                    if (!(c is >= 'A' and <= 'Z' or >= 'a' and <= 'z' or >= '0' and <= '9' or '+' or '/' or '=')) return null;
+                try
+                {
+                    var bytes = Convert.FromBase64String(value);
+                    return Convert.ToBase64String(bytes) == value ? bytes : null;
+                }
+                catch (FormatException) { return null; }
+            }
+
+            static bool ZipMagic(byte[] bytes) => bytes.Length >= 4 && bytes[0] == 0x50 && bytes[1] == 0x4b &&
+                ((bytes[2] == 3 && bytes[3] == 4) || (bytes[2] == 5 && bytes[3] == 6) || (bytes[2] == 7 && bytes[3] == 8));
+            static bool GzipMagic(byte[] bytes) => bytes.Length >= 2 && bytes[0] == 0x1f && bytes[1] == 0x8b;
+
+            static string? ArchiveKind(string path, byte[]? bytes)
+            {
+                if (bytes != null)
+                {
+                    if (ZipMagic(bytes)) return "zip";
+                    if (GzipMagic(bytes)) return "gzip";
+                }
+                if (path.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)) return "zip";
+                if (path.EndsWith(".gz", StringComparison.OrdinalIgnoreCase) || path.EndsWith(".tgz", StringComparison.OrdinalIgnoreCase))
+                    return "gzip";
+                foreach (var ext in new[] { ".7z", ".rar", ".tar", ".bz2", ".xz" })
+                    if (path.EndsWith(ext, StringComparison.OrdinalIgnoreCase)) return "unknown";
+                return null;
+            }
+
+            static byte[] ReadExpanded(Stream input, ref int remaining, Func<bool> withinTime)
+            {
+                using var result = new MemoryStream();
+                var buffer = new byte[4096];
+                while (true)
+                {
+                    if (!withinTime()) throw new IOException("archive-time");
+                    int n = input.Read(buffer, 0, Math.Min(buffer.Length, remaining + 1));
+                    if (n == 0) break;
+                    if (n > remaining) throw new IOException("archive-expanded-limit");
+                    remaining -= n;
+                    result.Write(buffer, 0, n);
+                }
+                return result.ToArray();
+            }
+
+            static Dictionary<string, byte[]> ZipEntries(byte[] bytes, ref int remaining, ref int entries,
+                Func<bool> withinTime)
+            {
+                using var stream = new MemoryStream(bytes, false);
+                using var zip = new ZipArchive(stream, ZipArchiveMode.Read);
+                var result = new Dictionary<string, byte[]>(StringComparer.OrdinalIgnoreCase);
+                var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+                foreach (var entry in zip.Entries)
+                {
+                    if (--entries < 0 || !withinTime()) throw new IOException("archive-entry-limit");
+                    var path = entry.FullName.Replace('\\', '/');
+                    var name = path.TrimEnd('/');
+                    if (name.Length == 0 || name.Length > 512 || name.IndexOf(':') >= 0 ||
+                        name.Split('/').Any(x => x.Length == 0 || x == ".." || x == ".") || !names.Add(name) ||
+                        ((entry.ExternalAttributes >> 16) & 0xf000) == 0xa000)
+                        throw new IOException("archive-entry-name");
+                    if (path.EndsWith("/", StringComparison.Ordinal))
+                    {
+                        if (entry.Length != 0) throw new IOException("archive-directory-data");
+                        continue;
+                    }
+                    if (entry.Length > remaining || entry.Length > MaxContent) throw new IOException("archive-expanded-limit");
+                    using var input = entry.Open();
+                    var data = ReadExpanded(input, ref remaining, withinTime);
+                    if (data.LongLength != entry.Length) throw new IOException("archive-entry-size");
+                    result.Add(name, data);
+                }
+                return result;
+            }
+
+            internal static bool ConfirmsArchive(byte[] data, Dictionary<string, byte[]> expected)
+            {
+                try
+                {
+                    int remaining = MaxExpanded, entries = MaxPackedEntries;
+                    var elapsed = System.Diagnostics.Stopwatch.StartNew();
+                    var actual = ZipEntries(data, ref remaining, ref entries, () => elapsed.ElapsedMilliseconds <= 120);
+                    return actual.Count == expected.Count && expected.All(pair =>
+                        actual.TryGetValue(pair.Key, out var file) && file.SequenceEqual(pair.Value));
+                }
+                catch { return false; }
+            }
+
+            bool PlanArchive(object command)
+            {
+                var args = new Args(command, Paths.Concat(new[] { "DestinationPath", "CompressionLevel" }).ToArray(), new[] { "Force" });
+                var source = PathArg(args, 0, out int total);
+                var dest = args.Get("DestinationPath") ?? args.Plain.ElementAtOrDefault(total++);
+                if (!args.Valid || source == null || dest == null || args.Plain.Count != total || barrier ||
+                    plan.Work.Count >= MaxEffects || policy == null || policyProblem.Length != 0) return false;
+                if (args.Has("CompressionLevel") && !new[] { "Optimal", "Fastest", "NoCompression" }
+                    .Contains(Value(args.Get("CompressionLevel")).Text, StringComparer.OrdinalIgnoreCase)) return false;
+                var from = Disk.Bind(Value(source).Text, cwd);
+                var to = Disk.Bind(Value(dest).Text, cwd);
+                if (from == null || to == null || PathEq(from, to) || !to.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ||
+                    !Disk.ClearAncestors(from) || PendingFiles.ContainsKey(from) || plannedFiles.Contains(to)) return false;
+                var stamp = Disk.TargetStamp(to);
+                if (stamp == null || (stamp.Length != 0 && !args.Has("Force"))) return false;
+                var expected = new Dictionary<string, byte[]>(StringComparer.OrdinalIgnoreCase);
+                var labels = new List<Mark>();
+                int totalBytes = 0, visits = 0;
+                bool complete = true;
+                bool Collect(string path, string archivePath, int depth)
+                {
+                    if (++visits > 32 || clock.ElapsedMilliseconds > 120 || depth > 8 ||
+                        !Disk.ClearAncestors(path) || PathEq(path, to)) return false;
+                    var attributes = System.IO.File.GetAttributes(path);
+                    if ((attributes & FileAttributes.Hidden) != 0) return false; // stock cmdlet omits hidden inputs
+                    if ((attributes & FileAttributes.Directory) != 0)
+                    {
+                        foreach (var child in Directory.EnumerateFileSystemEntries(path))
+                            if (!Collect(child, archivePath + "/" + Path.GetFileName(child), depth + 1)) return false;
+                        return true;
+                    }
+                    var content = File(path, false, out var sample, forceBytes: true);
+                    if (sample?.Bytes == null || expected.ContainsKey(archivePath) || totalBytes + sample.Bytes.Length > MaxExpanded)
+                        return false;
+                    totalBytes += sample.Bytes.Length;
+                    expected.Add(archivePath, sample.Bytes);
+                    labels.AddRange(DiscoverSendContent(content).Tags);
+                    complete &= content.Complete;
+                    return true;
+                }
+                try
+                {
+                    if (!Collect(from, Path.GetFileName(from.TrimEnd('\\')), 0) || expected.Count == 0) return false;
+                }
+                catch { return false; }
+                var tags = Merge(labels).Select(t => t.Via(to)).ToArray();
+                plannedFiles.Add(to);
+                plan.Work.Add(new PolicyWork { Target = to, From = from, Before = stamp, Archive = expected, Tags = tags });
+                // A pre-existing archive can still be sent if replacement fails. Use
+                // predicted provenance only for a newly created output.
+                if (stamp.Length == 0)
+                    predictedWrites[to] = new Payload { SourceRef = to, Tags = tags,
+                        Complete = complete, Issue = complete ? "" : "archive-source-content" };
+                return true;
+            }
+
+            Payload InspectPacked(byte[]? bytes, string path, string kind)
+            {
+                if (bytes == null) return Missing("archive-input-limit");
+                if (kind == "unknown") return Missing("archive-format");
+                var labels = new List<Mark>();
+                int remaining = MaxExpanded, entries = MaxPackedEntries;
+                var started = System.Diagnostics.Stopwatch.StartNew();
+                bool WithinTime() => started.ElapsedMilliseconds <= 120;
+                int visitLimit = 96;
+                bool Walk(byte[] content, string origin, string? format, int depth)
+                {
+                    if (--visitLimit < 0) return false;
+                    if (format == null)
+                    {
+                        var decoded = Disk.Decode(content);
+                        if (decoded == null) return policy?.Rules.All(r => r.Texts.Length == 0) == true;
+                        labels.AddRange(Text(decoded, origin).Tags);
+                        var wrapped = CanonicalBase64(decoded);
+                        if (wrapped != null && Disk.Decode(wrapped) is string clear)
+                            labels.AddRange(Text(clear, origin + " → Base64").Tags);
+                        return true;
+                    }
+                    if (depth >= MaxPackedDepth || format == "unknown") return false;
+                    try
+                    {
+                        if (format == "zip")
+                        {
+                            bool complete = true;
+                            foreach (var pair in ZipEntries(content, ref remaining, ref entries, WithinTime))
+                                complete = Walk(pair.Value, origin + "!" + pair.Key, ArchiveKind(pair.Key, pair.Value), depth + 1) && complete;
+                            return complete;
+                        }
+                        if (!GzipMagic(content)) return false;
+                        using var input = new MemoryStream(content, false);
+                        using var gzip = new GZipStream(input, CompressionMode.Decompress);
+                        int before = remaining;
+                        // GZipStream has no declared size: charge the expanded bytes as they are read.
+                        var clear = ReadExpanded(gzip, ref remaining, WithinTime);
+                        if (before - remaining > MaxContent) return false;
+                        string name = origin.EndsWith(".gz", StringComparison.OrdinalIgnoreCase) ? origin.Substring(0, origin.Length - 3) : origin + "!gzip";
+                        return Walk(clear, name, ArchiveKind(name, clear), depth + 1);
+                    }
+                    catch (InvalidDataException) { return false; }
+                    catch (IOException) { return false; }
+                    catch (NotSupportedException) { return false; }
+                }
+                bool checkedAll = Walk(bytes, path, kind, 0);
+                return new Payload { Bytes = bytes, Complete = checkedAll, SourceRef = path,
+                    Issue = checkedAll ? "" : "archive-unreadable-or-limit", Tags = Merge(labels) };
+            }
+
+            Payload DiscoverSendContent(Payload input)
+            {
+                if (input.Bytes != null && ArchiveKind("", input.Bytes) is string packed)
+                    return Combine(input, InspectPacked(input.Bytes, input.SourceRef, packed), preserveCompleteness: false);
+                var decoded = CanonicalBase64(input.PipeText ?? input.Text);
+                if (decoded == null) return input;
+                string origin = (string.IsNullOrEmpty(input.SourceRef) ? "body" : input.SourceRef) + " → Base64";
+                if (ArchiveKind("", decoded) is string kind)
+                    return Combine(input, InspectPacked(decoded, origin, kind), preserveCompleteness: false);
+                var inspection = Text(Disk.Decode(decoded), origin);
+                // Arbitrary canonical-looking binary text isn't evidence by itself.
+                return Combine(input, inspection, preserveCompleteness: true);
+            }
+
+            Payload Combine(Payload source, Payload extra, bool preserveCompleteness)
+            {
+                return new Payload { Text = source.Text, PipeText = source.PipeText, Bytes = source.Bytes, IsString = source.IsString,
+                    SourceRef = source.SourceRef, Tags = Merge(source.Tags.Concat(extra.Tags)),
+                    Complete = preserveCompleteness ? source.Complete : extra.Complete,
+                    Issue = preserveCompleteness || extra.Complete ? source.Issue : extra.Issue };
+            }
+        }
+    }
+}
diff --git a/ast/GitProof.cs b/ast/GitProof.cs
new file mode 100644
index 0000000..9ad69bc
--- /dev/null
+++ b/ast/GitProof.cs
@@ -0,0 +1,294 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading.Tasks;
+
+namespace PowerShell7Guard
+{
+    public static partial class AstBridge
+    {
+        sealed class GitProof
+        {
+            internal string Endpoint = "";
+            internal bool Network, Loopback;
+            internal Payload[] Parts = Array.Empty<Payload>();
+            const int MaxGitObjects = 192, MaxCommits = 32;
+            static readonly string[] OverrideVariables = { "GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR",
+                "GIT_CONFIG", "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM",
+                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_NAMESPACE", "GIT_REPLACE_REF_BASE" };
+            static bool NoOverrides() => OverrideVariables.All(x => string.IsNullOrEmpty(Environment.GetEnvironmentVariable(x)));
+            static bool ObjectId(string s) => Regex.IsMatch(s, @"^(?:[0-9a-f]{40}|[0-9a-f]{64})$");
+            static bool GitRef(string s) => Regex.IsMatch(s, @"^refs/heads/[A-Za-z0-9_./-]{1,160}$") &&
+                !s.Contains("..") && !s.Contains("//") && !s.EndsWith("/", StringComparison.Ordinal) &&
+                !s.EndsWith(".", StringComparison.Ordinal) && !s.EndsWith(".lock", StringComparison.OrdinalIgnoreCase);
+            static bool Args(string?[] args) => args.Length >= 2 && args.Length <= 9 && args[0] != null &&
+                Regex.IsMatch(args[0]!, @"^[A-Za-z0-9_.][A-Za-z0-9_.-]{0,63}$") &&
+                args.Skip(1).All(a => a != null && a.Split(':').Length == 2 &&
+                    GitRef(a.Split(':')[0].TrimStart('+')) && GitRef(a.Split(':')[1]));
+            static string? Repo(string? cwd)
+            {
+                if (cwd == null || !Disk.ClearAncestors(cwd)) return null;
+                for (int i = 0; i < 12 && cwd != null; i++, cwd = Path.GetDirectoryName(cwd))
+                {
+                    var dot = Path.Combine(cwd, ".git");
+                    if (Directory.Exists(dot)) return Disk.ClearAncestors(dot) ? cwd : null;
+                    if (File.Exists(dot)) return null; // linked worktree: not yet covered
+                }
+                return null;
+            }
+            static string ProofKey(string repo, IEnumerable<string?> args)
+            {
+                ulong hash = 14695981039346656037UL;
+                foreach (char c in repo.ToUpperInvariant() + "\0" + string.Join("\0", args))
+                    hash = unchecked((hash ^ c) * 1099511628211UL);
+                return hash.ToString("x16", CultureInfo.InvariantCulture);
+            }
+            static bool NetworkTarget(string url) =>
+                Uri.TryCreate(url, UriKind.Absolute, out var u) && (u.Scheme == "https" || u.Scheme == "http" || u.Scheme == "ssh") &&
+                    u.Host.Length != 0 && u.UserInfo.IndexOf(':') < 0 && string.IsNullOrEmpty(u.Query) ||
+                Regex.IsMatch(url, @"^(?:[A-Za-z0-9._-]+@)?[A-Za-z0-9.-]{2,}:[^:\s]+$");
+            static string? ConfigStamp(string path)
+            {
+                return Disk.TargetStamp(Path.GetFullPath(path));
+            }
+            static string? ReadRef(string dot, string name, Disk.Sample? packed)
+            {
+                var path = Path.Combine(dot, name.Replace('/', '\\'));
+                var file = Disk.TrySample(path, true);
+                var direct = file?.Text?.Trim();
+                if (direct != null) return ObjectId(direct) ? direct : null;
+                if (Disk.TargetStamp(path) != "" || packed?.Text == null) return null;
+                return Lines(packed.Text).Select(l => l.Split(' ')).Where(x => x.Length == 2 && x[1] == name && ObjectId(x[0]))
+                    .Select(x => x[0]).FirstOrDefault();
+            }
+            static string[] Lines(string value) => value.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
+            internal static GitProof? TryRead(string? cwd, string?[] args, Policy? policy)
+            {
+                try
+                {
+                    if (policy == null || !Args(args) || !NoOverrides() || Repo(cwd) is not string repo) return null;
+                    var data = Store.ReadGit(ProofKey(repo, args));
+                    if (data == null) return null;
+                    var doc = new Toml(data);
+                    var receipt = doc.Sections.Single(s => s.Name == "[proof");
+                    if (!PathEq(receipt.Get("repo"), repo) || !receipt.Array("args").SequenceEqual(args) ||
+                        !DateTime.TryParse(receipt.Get("time"), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var time) ||
+                        (DateTime.UtcNow - time).TotalSeconds is < 0 or > 60 ||
+                        ConfigStamp(Store.Config) != receipt.Get("policy_stamp")) return null;
+                    var configPaths = receipt.Array("config_paths");
+                    var configStamps = receipt.Array("config_stamps");
+                    if (configPaths.Length == 0 || configPaths.Length != configStamps.Length || configPaths.Length > 20) return null;
+                    for (int i = 0; i < configPaths.Length; i++)
+                        if (ConfigStamp(configPaths[i]) != configStamps[i]) return null;
+                    var dot = Path.Combine(repo, ".git");
+                    var packed = Disk.TrySample(Path.Combine(dot, "packed-refs"), true);
+                    var sources = receipt.Array("sources");
+                    if (sources.Length != args.Length - 1) return null;
+                    for (int i = 0; i < sources.Length; i++)
+                        if (ReadRef(dot, args[i + 1]!.Split(':')[0].TrimStart('+'), packed) != sources[i]) return null;
+                    var endpoint = receipt.Get("endpoint");
+                    var marks = doc.Sections.Where(s => s.Name == "[[marks" && policy.Rules.Any(r => r.Id == s.Get("rule_id")))
+                        .Select(s => new Mark(s.Get("rule_id"), s.Get("origin"), s.Get("route"))).Take(64).ToArray();
+                    return new GitProof { Endpoint = endpoint, Network = NetworkTarget(endpoint), Loopback = LoopbackSsh(endpoint),
+                        Parts = new[] { new Payload
+                    { Complete = receipt.Get("complete") == "yes", Issue = "git-object-content", Tags = marks } } };
+                }
+                catch { return null; }
+            }
+
+            static string Arg(string s) => "\"" + Regex.Replace(s, @"(\\*)""", "$1$1\\\"").Replace("\0", "") +
+                new string('\\', s.Reverse().TakeWhile(c => c == '\\').Count()) + "\"";
+            static byte[] Limited(Stream stream, int cap)
+            {
+                using var output = new MemoryStream();
+                var buf = new byte[4096];
+                int n;
+                while ((n = stream.Read(buf, 0, buf.Length)) != 0)
+                {
+                    if (output.Length + n > cap) throw new IOException("Git output limit");
+                    output.Write(buf, 0, n);
+                }
+                return output.ToArray();
+            }
+            static byte[] Git(string executable, string repo, int cap, params string[] arguments)
+            {
+                var info = new ProcessStartInfo(executable, string.Join(" ", arguments.Select(Arg)))
+                { WorkingDirectory = repo, RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false, CreateNoWindow = true };
+                info.EnvironmentVariables["GIT_TERMINAL_PROMPT"] = "0";
+                info.EnvironmentVariables["GIT_OPTIONAL_LOCKS"] = "0";
+                using var child = Process.Start(info) ?? throw new IOException("git process");
+                var output = Task.Run(() => Limited(child.StandardOutput.BaseStream, cap));
+                var error = Task.Run(() => Limited(child.StandardError.BaseStream, 16384));
+                try
+                {
+                    if (!child.WaitForExit(8000) || !Task.WaitAll(new Task[] { output, error }, 1000) || child.ExitCode != 0)
+                        throw new IOException("git preflight command failed: " + arguments.First());
+                    return output.Result;
+                }
+                finally { if (!child.HasExited) child.Kill(); }
+            }
+            static string StringList(IEnumerable<string> values) => "[" + string.Join(", ", values.Select(Toml.Quote)) + "]";
+            static string Field(string n, string v) => n + " = " + Toml.Quote(v) + "\n";
+
+            internal static string Prepare(string executable, string location, string[] args)
+            {
+                if (!Args(args) || !NoOverrides() || Repo(location) is not string repo)
+                    throw new ArgumentException("Use a supported repository and explicit refs/heads/SRC:refs/heads/DST arguments.");
+                var dot = Path.Combine(repo, ".git");
+                var deadline = Stopwatch.StartNew();
+                string[] Run(int max, params string[] cmd)
+                {
+                    if (deadline.Elapsed.TotalSeconds > 25) throw new IOException("preflight time limit");
+                    return Lines(StrictUtf8.GetString(Git(executable, repo, max, cmd)));
+                }
+                Store.Refresh();
+                var policy = Store.Current(out string issue) ?? throw new IOException(issue);
+                var policyStamp = ConfigStamp(Store.Config);
+                if (!string.IsNullOrEmpty(issue) || string.IsNullOrEmpty(policyStamp)) throw new IOException("policy-unavailable");
+                var configs = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
+                { Path.Combine(dot, "config"), Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".gitconfig") };
+                var xdg = Environment.GetEnvironmentVariable("XDG_CONFIG_HOME");
+                configs.Add(Path.Combine(string.IsNullOrEmpty(xdg) ? Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".config") : xdg!,
+                    "git", "config"));
+                foreach (var line in Run(64 * 1024, "config", "--list", "--show-origin"))
+                {
+                    var pair = line.Split(new[] { '\t' }, 2);
+                    if (pair.Length != 2 || !pair[0].StartsWith("file:", StringComparison.Ordinal))
+                        throw new IOException("unsupported config origin");
+                    var key = pair[1].Split('=')[0];
+                    if (key.StartsWith("include", StringComparison.OrdinalIgnoreCase) || key.StartsWith("url.", StringComparison.OrdinalIgnoreCase) ||
+                        key.Equals("extensions.worktreeconfig", StringComparison.OrdinalIgnoreCase) || key.EndsWith(".mirror", StringComparison.OrdinalIgnoreCase) ||
+                        key.Equals("push.followtags", StringComparison.OrdinalIgnoreCase))
+                        throw new IOException("configuration can change the set or destination of pushed objects");
+                    configs.Add(Path.GetFullPath(Path.Combine(repo, pair[0].Substring(5).Trim('"'))));
+                }
+                if (configs.Count > 20) throw new IOException("configuration set limit");
+                var viableConfigs = configs.Where(p => File.Exists(p) || Directory.Exists(Path.GetDirectoryName(p)!)).ToArray();
+                var stamps = viableConfigs.Select(ConfigStamp).ToArray();
+                if (stamps.Any(s => s == null)) throw new IOException("configuration unavailable");
+                var endpoints = Run(16384, "remote", "get-url", "--push", "--all", args[0]);
+                if (endpoints.Length != 1 || (!NetworkTarget(endpoints[0]) && Disk.Bind(endpoints[0], repo) == null))
+                    throw new IOException("unsupported remote");
+                var endpoint = endpoints[0];
+                var queryStart = DateTime.UtcNow;
+                var network = NetworkTarget(endpoint);
+                var loopback = network && LoopbackSsh(endpoint);
+                string[] remote;
+                if (loopback)
+                    remote = Array.Empty<string>();
+                else if (network)
+                    remote = Run(128 * 1024, "ls-remote", "--refs", "--", endpoint);
+                else
+                {
+                    var local = Disk.Bind(endpoint, repo)!;
+                    var localDot = Directory.Exists(Path.Combine(local, ".git")) ? Path.Combine(local, ".git") : local;
+                    if (!Disk.ClearAncestors(localDot)) throw new IOException("local remote unavailable");
+                    remote = Run(128 * 1024, "--git-dir=" + localDot, "for-each-ref", "--format=%(objectname)%09%(refname)");
+                }
+                var baselines = remote.Select(l => l.Split('\t')).ToArray();
+                if (baselines.Length > 128 || baselines.Any(p => p.Length != 2 || !ObjectId(p[0]) || !p[1].StartsWith("refs/", StringComparison.Ordinal)))
+                    throw new IOException("remote baseline limit");
+                var specs = args.Skip(1).Select(a => a.Split(':')[0].TrimStart('+')).ToArray();
+                var packed = Disk.TrySample(Path.Combine(dot, "packed-refs"), true);
+                var sources = specs.Select(s => ReadRef(dot, s, packed) ?? throw new IOException("local ref unavailable")).ToArray();
+                var exclusions = baselines.Select(p => "^" + p[0]).Distinct().ToArray();
+                var revisions = sources.Concat(exclusions).ToArray();
+                var commits = loopback ? Array.Empty<string>() :
+                    Run(8192, new[] { "rev-list", "--max-count=" + (MaxCommits + 1) }.Concat(revisions).ToArray());
+                if (commits.Length > MaxCommits || commits.Any(c => !ObjectId(c))) throw new IOException("commit limit");
+                var allObjects = loopback ? Array.Empty<string>() :
+                    Run(128 * 1024, new[] { "rev-list", "--objects", "--no-object-names" }.Concat(revisions).ToArray());
+                if (allObjects.Length > MaxGitObjects || allObjects.Any(x => !ObjectId(x))) throw new IOException("object limit");
+                var outgoing = new HashSet<string>(allObjects, StringComparer.Ordinal);
+                var marks = new Dictionary<string, Mark>(StringComparer.Ordinal);
+                var inspected = new HashSet<string>(StringComparer.Ordinal);
+                var blobBytes = new Dictionary<string, byte[]?>(StringComparer.Ordinal);
+                bool complete = true;
+                bool textRules = policy.Rules.Any(r => r.Texts.Length > 0);
+                void Match(string name, string? text, bool path)
+                {
+                    if (text == null && textRules) complete = false;
+                    foreach (var r in policy.Rules)
+                    {
+                        if (marks.ContainsKey(r.Id)) continue;
+                        if ((path && (r.Files.Any(f => PathEq(f, name)) || r.Folders.Any(f => name.StartsWith(
+                                f.TrimEnd('\\') + "\\", StringComparison.OrdinalIgnoreCase)))) ||
+                            (text != null && r.Texts.Any(t => text.IndexOf(t, StringComparison.Ordinal) >= 0)))
+                            marks[r.Id] = new Mark(r.Id, name, name);
+                    }
+                }
+                foreach (var commit in commits)
+                {
+                    if (textRules)
+                    {
+                        var content = Disk.Decode(Git(executable, repo, MaxContent, "cat-file", "commit", commit));
+                        Match("commit:" + commit, content, false);
+                    }
+                    var treeData = StrictUtf8.GetString(Git(executable, repo, 512 * 1024, "ls-tree", "-r", "-z", commit));
+                    foreach (var row in treeData.Split(new[] { '\0' }, StringSplitOptions.RemoveEmptyEntries))
+                    {
+                        var tab = row.IndexOf('\t');
+                        if (tab < 0) throw new IOException("invalid git tree");
+                        var head = row.Substring(0, tab).Split(' ');
+                        if (head.Length != 3 || head[1] != "blob" || !outgoing.Contains(head[2])) continue;
+                        var relative = row.Substring(tab + 1);
+                        var target = Disk.Bind(relative, repo);
+                        if (target == null || !target.StartsWith(repo.TrimEnd('\\') + "\\", StringComparison.OrdinalIgnoreCase))
+                        { complete = false; continue; }
+                        if (!inspected.Add(head[2] + "\0" + target)) continue;
+                        if (inspected.Count > 1024) throw new IOException("path binding limit");
+                        var copies = policy.Rules.SelectMany(r => r.Copies.Where(entry =>
+                            PathEq(ConfigPath(entry.Get("path"), Path.GetDirectoryName(Store.Config)!), target))
+                            .Select(entry => (rule: r, entry))).ToArray();
+                        byte[]? raw = null;
+                        if ((textRules || copies.Length != 0) && !blobBytes.TryGetValue(head[2], out raw))
+                        {
+                            var bytes = Run(128, "cat-file", "-s", head[2]);
+                            if (bytes.Length == 1 && long.TryParse(bytes[0], out var length) && length <= MaxContent)
+                                raw = Git(executable, repo, MaxContent, "cat-file", "blob", head[2]);
+                            blobBytes[head[2]] = raw;
+                        }
+                        Match(target, raw == null ? null : Disk.Decode(raw), true);
+                        if (copies.Length != 0)
+                        {
+                            var current = Disk.TrySample(target, true);
+                            foreach (var copy in copies)
+                            {
+                                if (raw == null || current?.Bytes == null || current.Stamp != copy.entry.Get("stamp") ||
+                                    !raw.SequenceEqual(current.Bytes)) { complete = false; continue; }
+                                var origin = copy.entry.Get("origin");
+                                if (origin.Length == 0) origin = copy.entry.Get("copied_from");
+                                if (!marks.ContainsKey(copy.rule.Id)) marks[copy.rule.Id] =
+                                    new Mark(copy.rule.Id, origin, copy.entry.Get("route")).Via("git:" + target);
+                            }
+                        }
+                    }
+                }
+                if (ConfigStamp(Store.Config) != policyStamp || viableConfigs.Select(ConfigStamp).Where((s, i) => s != stamps[i]).Any())
+                    throw new IOException("policy or configuration changed during preflight");
+                var b = new StringBuilder("[proof]\n").Append(Field("repo", repo)).Append(Field("endpoint", endpoint))
+                    .Append(Field("time", queryStart.ToString("O", CultureInfo.InvariantCulture))).Append(Field("policy_stamp", policyStamp!))
+                    .Append(Field("complete", complete ? "yes" : "no")).Append("args = ").AppendLine(StringList(args))
+                    .Append("sources = ").AppendLine(StringList(sources))
+                    .Append("baseline = ").AppendLine(StringList(baselines.Select(p => p[1] + "=" + p[0])))
+                    .Append("config_paths = ").AppendLine(StringList(viableConfigs))
+                    .Append("config_stamps = ").AppendLine(StringList(stamps.Select(s => s!)));
+                foreach (var mark in marks.Values)
+                    b.Append("\n[[marks]]\n").Append(Field("rule_id", mark.Id)).Append(Field("origin", mark.Origin)).Append(Field("route", mark.Route));
+                if (!Store.SaveGit(ProofKey(repo, args), b.ToString())) throw new IOException("preflight storage unavailable");
+                return "preflight-ready; commits=" + commits.Length + "; objects=" + allObjects.Length + "; matched-rules=" + marks.Count +
+                    "; complete=" + complete + "; network=" + (network && !loopback) + (loopback ? "; loopback=True" : "");
+            }
+        }
+
+        // The optional preflight entry point is only called by the separate
+        // command-line helper, never by the AMSI callback.
+        public static string PrepareGitPush(string gitExe, string repository, string remote, string[] refspecs) =>
+            GitProof.Prepare(gitExe, repository, new[] { remote }.Concat(refspecs).ToArray());
+    }
+}
