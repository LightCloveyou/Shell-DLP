+                {
+                    if (n <= 1)
+                    {
+                        if (((ICollection<KeyValuePair<string, int>>)PendingFiles).Remove(new KeyValuePair<string, int>(Target, n))) break;
+                    }
+                    else if (PendingFiles.TryUpdate(Target, n - 1, n)) break;
+                }
+            }
+            internal void Commit(bool success, State state)
+            {
+                if (!success) { Release(); return; }
+                if (Interlocked.Increment(ref pendingWork) > 128)
+                { Interlocked.Decrement(ref pendingWork); Release(); return; }
+                if (!ThreadPool.QueueUserWorkItem(_ =>
+                {
+                    string outcome = "not-confirmed";
+                    try
+                    {
+                        var eventId = Guid.NewGuid().ToString("N");
+                        if (File)
+                        {
+                            var after = Disk.TrySample(Target, true);
+                            if (after != null && Before != after.Stamp && after.Bytes != null &&
