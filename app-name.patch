+enum class Scope { PowerShell7, Other, Unavailable };
+
+Scope InScope(IAmsiStream* stream) noexcept
+{
+    // Fits an extended-length Windows path plus the PowerShell app ID metadata.
+    // Bound the allocation independently of the scan content limit.
+    constexpr ULONG MaxAppNameBytes = 128 * 1024;
+    ULONG required = 0;
+    if (stream->GetAttribute(AMSI_ATTRIBUTE_APP_NAME, 0, nullptr, &required) != E_NOT_SUFFICIENT_BUFFER ||
+        required < sizeof(wchar_t) || required > MaxAppNameBytes || required % sizeof(wchar_t) != 0)
+        return Scope::Unavailable;
+
+    ScanBuffer app(required);
+    if (!app.text) return Scope::Unavailable;
+    ULONG actual = 0;
+    if (FAILED(stream->GetAttribute(AMSI_ATTRIBUTE_APP_NAME, app.size,
+                   reinterpret_cast<PBYTE>(app.text), &actual)) ||
+        actual < sizeof(wchar_t) || actual > app.size || actual % sizeof(wchar_t) != 0)
+        return Scope::Unavailable;
+
+    const auto length = actual / sizeof(wchar_t) - 1;
+    const std::wstring_view name{app.text, length};
+    if (app.text[length] != L'\0' || name.find(L'\0') != std::wstring_view::npos)
+        return Scope::Unavailable;
+    return guard::IsPowerShell7(name) ? Scope::PowerShell7 : Scope::Other;
+}
